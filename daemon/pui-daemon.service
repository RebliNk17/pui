[Unit]
Description=Pui Headless Cloud Daemon
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/pui/daemon
Environment=HOME=/home/ubuntu
Environment=NODE_ENV=production
Environment=PUI_DAEMON_NAME=pui-cloud
Environment=PUI_DAEMON_BIND=tailscale
Environment=PUI_DAEMON_PORT=4817
Environment=PUI_DAEMON_WORKSPACES=/home/ubuntu/workspaces
ExecStart=/usr/bin/node --experimental-strip-types /home/ubuntu/pui/daemon/src/index.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
